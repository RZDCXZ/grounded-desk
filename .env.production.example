# 复制为 .env.production.local，仅供维护者在本机执行云端发布与冒烟。
# 该文件不会自动上传到 Vercel；不要提交填入真实值的副本。
SUPABASE_PROJECT_REF=replace-with-20-character-project-ref
NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-me
SUPABASE_SECRET_KEY=sb_secret_replace-me

# 两个 HTTPS 来源应指向同一 Vercel Production 部署的不同域名。
APP_URL=https://groundeddesk.example.com
EMBED_APP_URL=https://embed.groundeddesk.example.com
ADMIN_EMAIL=admin@example.com

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=20000
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_RERANK_MODEL=BAAI/bge-reranker-v2-m3
SILICONFLOW_TIMEOUT_MS=20000
RETRIEVAL_CANDIDATE_LIMIT=20
RERANK_EVIDENCE_LIMIT=5
RERANK_NOISE_FLOOR=0.05
PROVIDER_RATE_LIMIT_RETRY_DELAY_MS=250
PUBLIC_DAILY_MESSAGE_BUDGET=500
PUBLIC_CONVERSATION_CONTEXT_MESSAGES=6

# 生产环境必须保持关闭。
DETERMINISTIC_AI=false
DETERMINISTIC_EMBEDDINGS=false
ALLOW_PRIVATE_WEB_SOURCES=false

# 云端公开体验冒烟应使用刚在后台维护并发布的真实知识来源。
CLOUD_SMOKE_QUESTION=replace-with-a-grounded-production-question
CLOUD_SMOKE_EXPECTED_SOURCE_TITLE=replace-with-the-expected-source-title

# 五项发布命令将脱敏结果写入该目录；目录已被 Git 忽略。
RELEASE_EVIDENCE_DIR=.release-evidence
