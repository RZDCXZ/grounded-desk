{
  "name": "grounded-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "start": "next start",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "db:reset": "supabase db reset",
    "test:db": "supabase test db",
    "test:service": "node --conditions=react-server --test tests/service/*.test.ts",
    "test:e2e": "pnpm db:reset && playwright test",
    "eval:retrieval": "node --env-file-if-exists=.env.local --conditions=react-server scripts/evaluate-retrieval.ts",
    "test": "pnpm typecheck && pnpm lint && pnpm test:service && pnpm db:reset && pnpm test:db && playwright test"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.62",
    "@supabase/ssr": "0.12.3",
    "@supabase/supabase-js": "2.110.8",
    "ai": "^6.0.235",
    "an-array-of-english-words": "^2.0.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "1.27.0",
    "next": "16.2.12",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
